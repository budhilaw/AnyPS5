#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D source;
layout(set = 0, binding = 1) uniform sampler pointSampler;
layout(set = 0, binding = 2, r32ui) uniform uimage2D target;
layout(set = 0, binding = 3, std430) buffer Results { uint words[]; } results;
layout(push_constant) uniform Push { uint salt; } push;

void main() {
    const ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    const vec4 texel = texelFetch(sampler2D(source, pointSampler), position, 0);
    const vec4 coarse = textureLod(sampler2D(source, pointSampler), (vec2(position) + 0.5) / 16.0, 1.0);
    const uint packed = packUnorm4x8(texel) ^ (packUnorm4x8(coarse) * 3u) ^ push.salt;
    const uint previous = imageLoad(target, position).x;
    imageStore(target, position, uvec4(previous + packed, 0u, 0u, 0u));
    results.words[position.y * 16 + position.x] = packed * 7u + previous;
}
